<div class="mb-2 flex flex-wrap items-baseline justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Issues</h1>
  <p class="text-sm text-zinc-500 tabular-nums"><%= pluralize(@pagy.count, "issue") %> found</p>
</div>
<p class="mb-6 max-w-prose text-sm text-pretty text-zinc-500">
  Quality problems with existing translations — broken interpolations and
  missing plural forms show up here; not-yet-translated strings live under each
  locale's <span class="font-medium text-zinc-700">Missing</span> filter.
</p>

<% if @rows.empty? %>
  <div class="rounded-lg border border-dashed border-green-600/20 bg-green-50 p-12 text-center text-sm text-green-700">
    No issues found.
  </div>
<% else %>
  <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full px-4 py-2 align-middle sm:px-6 lg:px-8">
      <table class="min-w-full divide-y divide-zinc-950/5 text-sm">
        <thead>
          <tr class="text-left font-semibold text-zinc-900">
            <th scope="col" class="py-3 pr-3 pl-0 whitespace-nowrap">Locale</th>
            <th scope="col" class="px-3 py-3 whitespace-nowrap">Source</th>
            <th scope="col" class="px-3 py-3 whitespace-nowrap">Problems</th>
            <th scope="col" class="py-3 pr-0 pl-3 text-right whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-950/5">
          <% @rows.each do |row| %>
            <tr class="align-top hover:bg-zinc-50">
              <td class="py-3 pr-3 pl-0 font-medium uppercase whitespace-nowrap text-zinc-900"><%= row.locale %></td>
              <td class="px-3 py-3 text-zinc-900"><%= truncate(source_text(row), length: 80) %></td>
              <td class="px-3 py-3"><%= render_issue_badges(row.issue_list, skip_missing: false) %></td>
              <td class="py-3 pr-0 pl-3 text-right whitespace-nowrap">
                <%= link_to "Fix", edit_translation_path(row.key, row.locale), class: "font-medium text-blue-600 hover:text-blue-500" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <%= render "escriba/shared/pagination", pagy: @pagy %>
<% end %>
