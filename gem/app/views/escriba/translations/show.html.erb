<nav class="mb-4 flex items-center gap-1 text-sm text-zinc-500">
  <%= link_to "All translations", translations_path, class: "font-medium text-blue-600 hover:text-blue-500" %>
  <span aria-hidden="true">›</span>
  <span class="font-mono text-zinc-400"><%= @key %></span>
</nav>

<h1 class="text-2xl font-semibold tracking-tight text-balance"><%= truncate(source_text(@dev_row), length: 120) %></h1>

<div class="mt-2 mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-zinc-500">
  <% if @dev_row.plural %>
    <span class="rounded bg-zinc-100 px-1.5 py-0.5 text-xs font-medium text-zinc-600">plural</span>
  <% end %>
  <% if @dev_row.meaning.present? %>
    <span>Meaning: <span class="text-zinc-700">“<%= @dev_row.meaning %>”</span></span>
  <% end %>
  <% if @dev_row.interpolation_names.present? %>
    <span>Interpolations:
      <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-xs text-zinc-700"><%= Array(@dev_row.interpolation_names).map { |n| "%{#{n}}" }.join(", ") %></code>
    </span>
  <% end %>
</div>

<h2 class="mb-3 text-lg font-semibold tracking-tight">Locales</h2>

<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
  <div class="inline-block min-w-full px-4 py-2 align-middle sm:px-6 lg:px-8">
    <table class="min-w-full divide-y divide-zinc-950/5 text-sm">
      <thead>
        <tr class="text-left font-semibold text-zinc-900">
          <th scope="col" class="py-3 pr-3 pl-0 whitespace-nowrap">Locale</th>
          <th scope="col" class="px-3 py-3 whitespace-nowrap">Value</th>
          <th scope="col" class="py-3 pr-0 pl-3 text-right whitespace-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-950/5">
        <% @available_locales.each do |locale| %>
          <% row = @rows_by_locale[locale.to_sym] %>
          <% locale_sym = locale.to_sym %>
          <% read_only = dev_locale_from_code? && locale_sym == dev_locale %>
          <tr class="align-top hover:bg-zinc-50">
            <td class="py-3 pr-3 pl-0 font-medium whitespace-nowrap text-zinc-900">
              <%= locale %>
              <% if locale_sym == dev_locale %>
                <span class="ml-1 rounded bg-zinc-100 px-1.5 py-0.5 text-xs font-normal text-zinc-500"><%= read_only ? "from source code" : "source" %></span>
              <% end %>
            </td>
            <td class="px-3 py-3">
              <% if read_only %>
                <% if @dev_row %><span class="text-zinc-900"><%= render_source(@dev_row) %></span><% end %>
              <% elsif row && row.value.present? %>
                <span class="text-zinc-900"><%= render_value(row) %></span>
                <%= pending_publish_badge(row) %>
                <% unless locale_sym == dev_locale %>
                  <div class="mt-1"><%= render_issue_badges(translation_issues(@dev_row, row)) %></div>
                <% end %>
              <% else %>
                <span class="text-zinc-400 italic">—</span>
              <% end %>
            </td>
            <td class="py-3 pr-0 pl-3 text-right whitespace-nowrap">
              <% unless read_only %>
                <%= link_to(row && row.value.present? ? "Edit" : "Translate", edit_translation_path(@key, locale), class: "font-medium text-blue-600 hover:text-blue-500") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
