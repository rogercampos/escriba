<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold tracking-tight">Translations</h1>

  <nav class="flex flex-wrap items-center gap-2">
    <% @available_locales.each do |loc| %>
      <% active = loc.to_sym == @locale %>
      <%= link_to loc, translations_path(locale: loc),
        class: "rounded-full px-3 py-1 text-sm font-medium transition #{active ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <% end %>
  </nav>
</div>

<% if @locale != dev_locale %>
  <p class="mb-4 text-sm">
    <% if params[:missing].present? %>
      <%= link_to "← Show all", translations_path(locale: @locale), class: "text-indigo-600 hover:text-indigo-500" %>
    <% else %>
      <%= link_to "Show only missing translations", translations_path(locale: @locale, missing: 1), class: "text-indigo-600 hover:text-indigo-500" %>
    <% end %>
  </p>
<% end %>

<% if @dev_rows.empty? %>
  <div class="rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center text-sm text-gray-500">
    No translations recorded yet. Strings show up here after the host application runs
    <code class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-gray-700">E18n.t(...)</code> at least once.
  </div>
<% else %>
  <div class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-gray-200">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr class="text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <th class="px-4 py-3">Source (<%= dev_locale %>)</th>
          <th class="px-4 py-3"><%= @locale %></th>
          <th class="px-4 py-3">Meaning</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @dev_rows.each do |dev| %>
          <% target = @values[dev.key] %>
          <tr class="align-top hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-900"><%= render_source(dev) %></td>
            <td class="px-4 py-3">
              <% if target && target.value.present? %>
                <span class="text-gray-900"><%= render_value(target) %></span>
              <% else %>
                <span class="italic text-gray-400">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-xs text-gray-500"><%= dev.meaning %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <% unless dev_locale_from_code? && @locale == dev_locale %>
                <%= link_to "Edit", edit_translation_path(dev.key, @locale), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
              <% end %>
              <%= link_to "All locales", translation_path(dev.key), class: "ml-3 font-medium text-gray-500 hover:text-gray-700" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
