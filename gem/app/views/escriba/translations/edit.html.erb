<nav class="mb-4 flex flex-wrap items-center gap-1 text-sm text-zinc-500">
  <%= link_to "All translations", translations_path, class: "font-medium text-blue-600 hover:text-blue-500" %>
  <span aria-hidden="true">›</span>
  <%= link_to @key, translation_path(@key), class: "font-mono font-medium text-blue-600 hover:text-blue-500" %>
  <span aria-hidden="true">›</span>
  <span>Edit <%= @locale %></span>
</nav>

<h1 class="mb-6 text-2xl font-semibold tracking-tight">Edit <span class="text-blue-600"><%= @locale %></span></h1>

<div class="mb-6 rounded-lg bg-white p-5 shadow-sm ring-1 ring-zinc-950/5">
  <dl class="space-y-4">
    <div>
      <dt class="mb-1 text-sm font-medium text-zinc-700">Source copy (<%= dev_locale %>)</dt>
      <dd class="rounded-md bg-zinc-100 px-3 py-2 font-mono text-sm whitespace-pre-wrap text-zinc-800"><%= render_source(@dev_row) %></dd>
    </div>

    <% if @dev_row.meaning.present? %>
      <div>
        <dt class="mb-1 text-sm font-medium text-zinc-700">Meaning</dt>
        <dd class="text-sm text-zinc-600"><%= @dev_row.meaning %></dd>
      </div>
    <% end %>

    <% if @dev_row.interpolation_names.present? %>
      <div>
        <dt class="mb-1 text-sm font-medium text-zinc-700">Interpolations</dt>
        <dd>
          <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-sm text-zinc-700"><%= Array(@dev_row.interpolation_names).map { |n| "%{#{n}}" }.join(", ") %></code>
        </dd>
      </div>
    <% end %>
  </dl>
</div>

<%= form_with url: update_translation_path(@key, @locale), method: :patch, local: true,
      class: "space-y-5 rounded-lg bg-white p-5 shadow-sm ring-1 ring-zinc-950/5" do %>
  <% if @row.plural %>
    <% existing = @row.value.is_a?(Hash) ? @row.value.transform_keys(&:to_s) : {} %>
    <% Escriba::KeyDeriver::PLURAL_FORM_KEYS.each do |form_key| %>
      <% field_id = "translation_value_#{form_key}" %>
      <div>
        <label for="<%= field_id %>" class="mb-1 flex flex-wrap items-baseline gap-2 text-sm font-medium text-zinc-700">
          <%= form_key %>
          <% if @dev_row.source_copy.is_a?(Hash) && @dev_row.source_copy[form_key.to_s] %>
            <span class="font-normal text-zinc-400 italic">source: <%= @dev_row.source_copy[form_key.to_s] %></span>
          <% end %>
        </label>
        <input type="text" id="<%= field_id %>" name="translation[value][<%= form_key %>]" value="<%= existing[form_key.to_s] %>"
          class="block w-full rounded-md border-0 px-3 py-2 text-sm text-zinc-900 ring-1 ring-inset ring-zinc-300 focus:ring-2 focus:ring-inset focus:ring-blue-600 max-sm:text-base">
      </div>
    <% end %>
  <% else %>
    <div>
      <label for="translation_value" class="mb-1 block text-sm font-medium text-zinc-700">Translation</label>
      <textarea id="translation_value" name="translation[value]" rows="3"
        class="block w-full rounded-md border-0 px-3 py-2 text-sm text-zinc-900 ring-1 ring-inset ring-zinc-300 focus:ring-2 focus:ring-inset focus:ring-blue-600 max-sm:text-base"><%= @row.value %></textarea>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <button type="submit" class="rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
      Save
    </button>
    <button type="submit" name="commit_next" value="1" class="rounded-md bg-blue-50 px-3 py-2 text-sm font-semibold text-blue-700 ring-1 ring-inset ring-blue-600/20 hover:bg-blue-100">
      Save &amp; next missing
    </button>
    <%= link_to "Cancel", translation_path(@key), class: "text-sm font-medium text-zinc-500 hover:text-zinc-700" %>
    <span class="ml-auto text-xs text-zinc-400">Goes live on the next deploy</span>
  </div>
<% end %>
