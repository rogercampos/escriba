# frozen_string_literal: true

require "bundler/gem_tasks"
require "minitest/test_task"

# Create test task but exclude dummy app files
Minitest::TestTask.create do |t|
  all_test_files = Dir.glob([
    "test/test_*.rb",
    "test/**/*_test.rb"
  ]).reject { |f| f.include?("test/dummy/") }

  t.test_globs = all_test_files

  # Load test_helper BEFORE minitest/autorun to ensure SimpleCov
  # registers its at_exit hook first (at_exit runs in LIFO order)
  t.test_prelude = 'require "test/test_helper"'
end

task default: :test

DUMMY_ROOT = File.expand_path("../dummy", __dir__)

desc "Run the dummy app's suite (system tests included; needs Chrome)"
task :test_dummy do
  Dir.chdir(DUMMY_ROOT) do
    # Bundler must resolve against the dummy app's own Gemfile.
    env = { "BUNDLE_GEMFILE" => File.join(DUMMY_ROOT, "Gemfile") }
    system(env, "bundle", "exec", "rails", "test:all") || exit(1)
  end
end
