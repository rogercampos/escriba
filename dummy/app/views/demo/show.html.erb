<h1><%= E18n.t("Welcome to the escriba dummy app") %></h1>

<p><%= E18n.t("This page exercises E18n.t across singular, plural, interpolated, and meaning-disambiguated calls.") %></p>

<h2><%= E18n.t("Singular examples") %></h2>
<ul aria-label="<%= E18n.t("Singular examples") %>">
  <li><%= E18n.t("Save", meaning: "to store") %></li>
  <li><%= E18n.t("Save", meaning: "to rescue") %></li>
  <li><%= E18n.t("Hello %{name}, you have %{count} new messages", name: "Roger", count: 7) %></li>
</ul>

<h2><%= E18n.t("Plural examples") %></h2>
<ul aria-label="<%= E18n.t("Plural examples") %>">
  <% [1, 5].each do |count| %>
    <li><%= E18n.t(one: "1 item in your inbox", other: "%{count} items in your inbox", count: count) %></li>
  <% end %>
  <% [1, 3].each do |count| %>
    <li><%= E18n.t(one: "%{count} day left", other: "%{count} days left", count: count) %></li>
  <% end %>
</ul>

<h2><%= E18n.t("Other languages") %></h2>
<ul aria-label="<%= E18n.t("Other languages") %>">
  <% I18n.available_locales.each do |locale| %>
    <li><%= link_to locale, demo_path(locale: locale) %></li>
  <% end %>
</ul>
